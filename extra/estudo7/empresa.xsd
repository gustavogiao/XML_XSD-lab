<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">


<xs:simpleType name="tipoType">
    <xs:restriction base="xs:string">
        <xs:enumeration value="EFETIVO"/>
        <xs:enumeration value="ESTAGIARIO"/>
    </xs:restriction>
</xs:simpleType>

<xs:simpleType name="salarioType">
    <xs:restriction base="xs:double">
        <xs:minInclusive value="1"/>
    </xs:restriction>
</xs:simpleType>

<xs:complexType name="departamentoType">
    <xs:sequence>
        <xs:element name="nome" type="xs:string"/>
        <xs:element name="responsavel" type="xs:string"/>
        <xs:element name="colaboradores">
            <xs:complexType>
                <xs:sequence>
                    <xs:element name="colaborador" maxOccurs="unbounded" type="colaboradorType"/>
                </xs:sequence>
            </xs:complexType>
        </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:int" use="required"/>
    <xs:attribute name="area" type="xs:string" use="required"/>
</xs:complexType>

<xs:complexType name="colaboradorType">
    <xs:sequence>
        <xs:element name="nome" type="xs:string"/>
        <xs:element name="email" type="xs:string"/>
        <xs:element name="salario" type="salarioType"/>
    </xs:sequence>
    <xs:attribute name="codigo" type="xs:string" use="required"/>
    <xs:attribute name="tipo" type="tipoType" use="required"/>
</xs:complexType>

<xs:element name="empresa">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="departamento" type="departamentoType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
</xs:element>


</xs:schema>